{
  "name": "fondoempleo",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "node scripts/probar-conexion.mjs && tsx src/db/migrar.ts && tsx src/db/importar-capacitaciones.ts --si-falta && tsx src/db/importar-cronograma.ts --si-falta && tsx src/db/importar-beneficiarios.ts --si-falta && tsx src/db/ordenar-archivos.ts && tsx src/db/crear-admin.ts",
    "dev": "node scripts/servidor.mjs dev",
    "build": "next build",
    "start": "node scripts/servidor.mjs start",
    "lint": "eslint",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrar.ts",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx src/db/seed.ts",
    "db:setup": "npm run db:probar && npm run db:migrate && npm run db:seed",
    "db:ver": "node scripts/ver-tablas.mjs",
    "db:pgadmin": "node scripts/abrir-pgadmin.mjs",
    "db:probar": "node scripts/probar-conexion.mjs",
    "red:puerto": "powershell -ExecutionPolicy Bypass -File scripts/abrir-puerto.ps1",
    "link": "node scripts/mostrar-link.mjs",
    "db:importar": "tsx src/db/importar-capacitaciones.ts",
    "db:importar-cronograma": "tsx src/db/importar-cronograma.ts",
    "db:limpiar-ejemplo": "tsx src/db/limpiar-ejemplo.ts",
    "db:importar-beneficiarios": "tsx src/db/importar-beneficiarios.ts",
    "archivos:ordenar": "tsx src/db/ordenar-archivos.ts",
    "db:crear-admin": "tsx src/db/crear-admin.ts",
    "db:restablecer-admin": "tsx src/db/restablecer-admin.ts"
  },
  "dependencies": {
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "dotenv": "^18.0.4",
    "drizzle-orm": "^0.45.3",
    "next": "16.3.6",
    "pg": "^8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
